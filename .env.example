# ─────────────────────────────────────────────────────────────
#  Образовательная платформа — переменные окружения (пример)
#  Скопируйте в .env и заполните. Секреты НЕ коммитятся (NFR-2.7).
# ─────────────────────────────────────────────────────────────

# --- Общие ---
NODE_ENV=development
PORT=4000
# Публичный origin фронтенда — используется для CORS-белого списка (NFR-2.6)
FRONTEND_ORIGIN=http://localhost:5173

# --- База данных (PostgreSQL) ---
# ПРОД: сервер БД физически в РК (DP-2, блокер §13)
DATABASE_URL=postgresql://edu:edu_dev_password@localhost:5433/edu_platform?schema=public

# --- Redis (очереди BullMQ, rate-limit, стриминг) ---
# Порт 6380: 6379 часто занят Redis другого проекта (см. docker-compose.yml)
REDIS_URL=redis://localhost:6380

# --- JWT / сессии (FR-1.6) ---
# Сгенерируйте длинные случайные значения: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=900          # секунд (15 мин)
JWT_REFRESH_TTL=1209600     # секунд (14 дней)
COOKIE_SECRET=change_me_cookie_signing_secret_min_32_chars

# --- LLM-шлюз (§5.1) ---
# Провайдер: mock | anthropic | openai | auto   (провайдер-агностично — §9.3)
# mock — детерминированный оффлайн-режим для локальной разработки без ключей и без утечки ПДн.
# auto — OpenAI, если задан OPENAI_API_KEY, иначе Anthropic, иначе mock.
# Проверить ключ и все режимы (текст, JSON, поток): npm run llm:ping --workspace @edu/backend
LLM_PROVIDER=mock
# Раздельный выбор модели под задачу (§5.6): генерация / диалог / судья.
# Пусто — модель по умолчанию для провайдера: openai → gpt-5.4-mini, anthropic → claude-haiku-4-5-20251001.
LLM_MODEL_GENERATION=
LLM_MODEL_DIALOG=
LLM_MODEL_JUDGE=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Уровень рассуждений reasoning-моделей OpenAI (GPT-5.x): none | low | medium | high | xhigh;
# пусто — не передавать (модели без рассуждений, совместимые эндпоинты).
# Диалог — none: быстрый поток и допустима temperature; судья и генерация — low.
OPENAI_REASONING_GENERATION=low
OPENAI_REASONING_DIALOG=none
OPENAI_REASONING_JUDGE=low
# Режим оркестрации по умолчанию (§5.4): TUTOR_JUDGE (двухвызовный) | SINGLE_CALL
ORCHESTRATION_MODE=TUTOR_JUDGE
# Договорной режим у провайдера (DP-5): требуется no-training / zero-retention
LLM_ZERO_RETENTION=true

# --- Согласие на исследование (FR-R.6) ---
RESEARCH_CONSENT_VERSION=2026-07-01

# --- Стоимость / лимиты по умолчанию (§5.6, конфигурируемо) ---
DEFAULT_MAX_AI_MESSAGES=22
# Токен-потолки по языкам (обязательный выход пилота §5.1; здесь — консервативные значения по умолчанию)
TOKEN_CEILING_EN=120000
TOKEN_CEILING_RU=160000
TOKEN_CEILING_KK=190000
# Макс. длина сообщения студента (FR-6.10)
MAX_STUDENT_MESSAGE_CHARS=1500
# Приостановка без FAILED при бездействии (§5.7)
SESSION_IDLE_PAUSE_MINUTES=60
# Автозакрытие в ABANDONED (§5.7)
SESSION_ABANDON_DAYS=7

# --- Трекинг ошибок (NFR-5.3) ---
# Пусто → Sentry выключен (no-op). Задайте DSN для включения.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Rate limiting (NFR-2.5, NFR-2.8) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LLM_MAX=30
# Ограничение параллелизма вызовов LLM (NFR-1.5)
LLM_MAX_CONCURRENCY=25

# Цена токенов gpt-5.4-mini, USD за 1M (для оценки стоимости)
LLM_PRICE_INPUT_PER_MTOK=0.75
LLM_PRICE_OUTPUT_PER_MTOK=4.5
LLM_PRICE_CACHED_INPUT_PER_MTOK=0.075

# Публичный адрес сайта — ссылки и QR проверки сертификата (иначе будут вести на localhost)
PUBLIC_APP_URL=http://localhost:5173

# --- Практикум: тьютор, судья, проверка утечки ответа (Inquiry 2.0) ---
DIALOG_TEMPERATURE=0.25
# Лимит выходных токенов реплики тьютора (ru/en) и для kk (казахский длиннее в токенах)
TUTOR_MAX_TOKENS=200
TUTOR_MAX_TOKENS_KK=250
TUTOR_MESSAGE_MAX_CHARS_KK=700
JUDGE_MAX_TOKENS=600
# Подтверждение вердикта «ответ достигнут» повторным вызовом судьи
JUDGE_CONFIRM_ENABLED=true
JUDGE_CONFIRM_EFFORT=medium
# Проверка реплики тьютора на раскрытие ответа ДО отправки студенту; closed — при сбое реплика не уходит
LEAK_CHECK_ENABLED=true
LEAK_CHECK_TIMEOUT_MS=3000
LEAK_CHECK_FAIL_MODE=closed

# --- Оцениваемые тесты и курс ---
# Пауза между попытками теста, мин (24 ч); Quiz.cooldownMinutes важнее
QUIZ_COOLDOWN_MINUTES=1440
# Незавершённая попытка старше N часов отправляется автоматически
QUIZ_ATTEMPT_MAX_HOURS=24
# Язык курса фиксируется после первой оцениваемой активности: after_first_graded | never
LANGUAGE_LOCK=after_first_graded
# Условие сертификата: PASS_ALL (сдать все оценивания) | COMPLETE_ALL
CERT_RULE=PASS_ALL
# Запрет смены исследовательских групп после старта сбора данных
STUDY_COHORTS_LOCKED=false
# Организация-эмитент в сертификате и на странице проверки
CERT_ISSUER_NAME=EduOpen

# --- Публичная регистрация и каталог ---
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_PUBLIC_MAX=120
