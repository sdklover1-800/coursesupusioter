# ─────────────────────────────────────────────────────────────────────────
#  Продакшн-конфигурация. Скопировать в .env.prod и заполнить:
#      cp .env.prod.example .env.prod && chmod 600 .env.prod
#
#  .env.prod закрыт .gitignore и .dockerignore — в git и в образ не попадает.
#  Файл читается дважды: `--env-file .env.prod` (подстановка в compose)
#  и `env_file:` (переменные внутри контейнеров).
# ─────────────────────────────────────────────────────────────────────────

# ── Домен и TLS ──────────────────────────────────────────────────────────
# A-запись eduopen.kz должна указывать на ЭТОТ сервер ДО первого запуска:
# Caddy проходит ACME-проверку Let's Encrypt при старте и без неё не поднимется.
SITE_ADDRESS=eduopen.kz

# Редирект www → apex. A-запись www.eduopen.kz существует, сертификат
# выпустится и на неё. Если www не нужен — оставьте значение по умолчанию
# (http://localhost:8081), тогда блок ни на что не влияет.
WWW_ADDRESS=www.eduopen.kz

# Реальный почтовый ящик: Let's Encrypt шлёт сюда предупреждения об
# истечении сертификата, если автопродление сломается.
ACME_EMAIL=dauletzeneve210@gmail.com

# ── Версия образов ───────────────────────────────────────────────────────
APP_VERSION=1.1.0

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Пароль: openssl rand -base64 32 | tr -d '/+=' | head -c 32
POSTGRES_USER=edu
POSTGRES_PASSWORD=
POSTGRES_DB=edu_platform

# ── Redis ────────────────────────────────────────────────────────────────
# Пароль: openssl rand -base64 32 | tr -d '/+=' | head -c 32
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb

# DATABASE_URL и REDIS_URL здесь НЕ задаются — compose собирает их
# из логинов/паролей выше (см. docker-compose.prod.yml).

# ── Приложение ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# CORS-белый список. При работе через Caddy фронтенд и API — один origin,
# но значение обязано совпадать с реальным адресом (NFR-2.6).
# www сюда добавлять не нужно: он редиректится на apex до запроса к API.
FRONTEND_ORIGIN=https://eduopen.kz

# ── Секреты аутентификации ───────────────────────────────────────────────
# Каждый: openssl rand -base64 48
# Ротация JWT_REFRESH_SECRET разлогинивает всех — планировать вне учебных часов.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ── LLM ──────────────────────────────────────────────────────────────────
# mock в проде недопустим: студенты получат заглушки вместо диалога.
LLM_PROVIDER=openai
LLM_MODEL_GENERATION=gpt-5.4-mini
LLM_MODEL_DIALOG=gpt-5.4-mini
LLM_MODEL_JUDGE=gpt-5.4-mini
# Уровень рассуждений GPT-5.x по назначению: none | low | medium | high | xhigh
OPENAI_REASONING_GENERATION=low
OPENAI_REASONING_DIALOG=none
OPENAI_REASONING_JUDGE=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ORCHESTRATION_MODE=TUTOR_JUDGE

# Запрет на хранение промптов у провайдера (§8, приватность студентов).
LLM_ZERO_RETENTION=true
LLM_MAX_CONCURRENCY=25
LLM_PRICE_INPUT_PER_MTOK=0.75
LLM_PRICE_OUTPUT_PER_MTOK=4.5
LLM_PRICE_CACHED_INPUT_PER_MTOK=0.075

# ── Учебный процесс ──────────────────────────────────────────────────────
RESEARCH_CONSENT_VERSION=2026-07-01
DEFAULT_MAX_AI_MESSAGES=22
TOKEN_CEILING_EN=120000
TOKEN_CEILING_RU=160000
TOKEN_CEILING_KK=190000
MAX_STUDENT_MESSAGE_CHARS=1500
SESSION_IDLE_PAUSE_MINUTES=60
SESSION_ABANDON_DAYS=7

# ── Ограничения запросов ─────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LLM_MAX=30

# ── Наблюдаемость ────────────────────────────────────────────────────────
# Пусто → Sentry выключен. DSN — не секрет, но и не для публикации.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Резервное копирование ────────────────────────────────────────────────
# Дампы содержат персональные данные студентов: каталог chmod 700,
# при выносе с сервера — шифровать.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# ── Лимиты ресурсов ──────────────────────────────────────────────────────
API_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=1g

# Публичный адрес сайта — ссылки и QR проверки сертификата. Пусто — первый адрес из
# FRONTEND_ORIGIN; при NODE_ENV=production локальный адрес (localhost/127.*) — ошибка старта.
PUBLIC_APP_URL=https://eduopen.kz

# --- Практикум: тьютор, судья, проверка утечки ответа (Inquiry 2.0) ---
DIALOG_TEMPERATURE=0.25
# Лимит выходных токенов реплики тьютора (ru/en) и для kk (казахский длиннее в токенах)
TUTOR_MAX_TOKENS=200
TUTOR_MAX_TOKENS_KK=250
TUTOR_MESSAGE_MAX_CHARS_KK=700
JUDGE_MAX_TOKENS=600
# Подтверждение вердикта «ответ достигнут» повторным вызовом судьи
JUDGE_CONFIRM_ENABLED=true
JUDGE_CONFIRM_EFFORT=medium
# Проверка реплики тьютора на раскрытие ответа ДО отправки студенту; closed — при сбое реплика не уходит
LEAK_CHECK_ENABLED=true
LEAK_CHECK_TIMEOUT_MS=3000
LEAK_CHECK_FAIL_MODE=closed

# --- Оцениваемые тесты и курс ---
# Методические переключатели: на время сбора данных исследования значения ниже
# (кроме STUDY_COHORTS_LOCKED — см. комментарий) должны совпадать с протоколом.
# Пауза между попытками теста, мин (исследование — 1440 = 24 ч, USER_DECISIONS §1); Quiz.cooldownMinutes важнее
QUIZ_COOLDOWN_MINUTES=1440
# Незавершённая попытка старше N часов отправляется автоматически
QUIZ_ATTEMPT_MAX_HOURS=24
# Язык курса фиксируется после первой оцениваемой активности: after_first_graded | never
# (исследование — только after_first_graded, USER_DECISIONS §3)
LANGUAGE_LOCK=after_first_graded
# Условие сертификата: PASS_ALL (сдать все оценивания) | COMPLETE_ALL (решение PI, до старта не менять)
CERT_RULE=PASS_ALL
# Запрет смены исследовательских групп после старта сбора данных: до старта — false
# (идёт распределение), С НАЧАЛА СБОРА ДАННЫХ — true (смена группы только админом с force)
STUDY_COHORTS_LOCKED=false
# Организация-эмитент в сертификате и на странице проверки
CERT_ISSUER_NAME=EduOpen

# --- Публичная регистрация и каталог ---
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_PUBLIC_MAX=120
