*.dump
*.sql.gz
*.backup
*.sqlite
*.sqlite3
pgdata/
apps/backend/prisma/*.db
apps/backend/prisma/*.db-journal

# Redis persistence
dump.rdb
appendonly*.aof
appendonlydir/

