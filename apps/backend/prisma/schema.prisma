// ─────────────────────────────────────────────────────────────────────────
//  Модель данных образовательной платформы (ТЗ §10).
//  Провайдер: PostgreSQL. ORM: Prisma.
//
//  Примечание по языкам (§6.1, §6.4): поля language — String (валидируются
//  Zod по перечню LANGUAGES из @edu/shared), а не Prisma-enum, чтобы добавление
//  нового языка не требовало миграции БД («список языков конфигурируемый»).
//  Cohort.condition — String по той же причине (§10.1: "AI_ASSISTED|...|").
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (фиксированные доменные множества) ──────────────────────────────

enum Role {
  STUDENT
  COURSE_MANAGER
  ADMIN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentType {
  QUIZ
  PRACTICAL
}

// Вид теста: итоговый модуля (оценивается) или тренировочный мини-квиз.
enum QuizKind {
  MODULE_FINAL
  LECTURE_MINI
  COURSE_FINAL
}

enum QuestionType {
  SINGLE_CHOICE
  TRUE_FALSE
  // расширяемо: MULTI_CHOICE, OPEN_ANSWER — позже (FR-5.1)
}

enum Difficulty {
  VERY_EASY
  EASY
  MEDIUM
  HARD
}

// Запись на курс. PENDING/REJECTED — самостоятельная заявка студента из каталога,
// ожидающая решения менеджера/админа; доступ к контенту — только ACTIVE/COMPLETED.
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  PENDING
  REJECTED
}

enum SessionStatus {
  IN_PROGRESS
  PASSED
  FAILED
  ABANDONED
}

enum OrchestrationMode {
  TUTOR_JUDGE
  SINGLE_CALL
}

enum ChatRole {
  AI
  STUDENT
  SYSTEM
}

enum GenerationType {
  QUIZ
  PRACTICAL
  MINI
  ALL
  LECTURE_SUMMARY // краткое содержание лекции (реализует BE4)
}

// Политика показа разбора официальной попытки (USER_DECISIONS §1):
//  - FULL_AFTER_FINAL (по умолчанию) — до сдачи или последней попытки виден только
//    «верно/неверно» по каждому вопросу; после — полный ключ и объяснения;
//  - SCORE_UNTIL_FINAL — до финала виден только балл, после — полный разбор;
//  - SCORE_ONLY — ключ не показывается никогда.
// Значения «полный разбор после каждой попытки» нет намеренно: он раскрыл бы ключ
// для второй попытки.
enum QuizReviewPolicy {
  FULL_AFTER_FINAL
  SCORE_UNTIL_FINAL
  SCORE_ONLY
}

// Какая попытка идёт в зачёт: лучшая (USER_DECISIONS §1) или первая.
enum QuizScoringRule {
  BEST
  FIRST
}

// Объект жалобы на контент.
enum ContentIssueTarget {
  QUIZ_QUESTION
  CHAT_MESSAGE
  LECTURE
  PRACTICAL_TASK
}

enum ContentIssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Источник: жалоба студента или системная отметка контент-скриптов
// (экспертная проверка, вычитка носителем языка, проверка фактов).
enum ContentIssueOrigin {
  STUDENT
  SYSTEM
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  ERROR
}

enum PromptKind {
  QUIZ_GEN
  PRACTICAL_GEN
  SOCRATIC_TUTOR
  JUDGE
}

// ── Пользователи и исследовательские группы ───────────────────────────────

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  role                   Role      @default(STUDENT)
  name                   String
  interfaceLanguage      String    @default("ru") // kk|ru|en (§6.1)
  cohortId               String?
  cohort                 Cohort?   @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  // Информированное согласие (FR-R.6): факт, дата, версия текста
  researchConsentAt      DateTime?
  researchConsentVersion String?
  // Стартовый пароль/сброс (FR-1.4, FR-1.7)
  mustChangePassword     Boolean   @default(false)
  isActive               Boolean   @default(true)
  // Аккаунт создан самостоятельной регистрацией из каталога: владение email НЕ
  // проверялось — в очереди заявок и списке пользователей помечается для админа.
  selfRegisteredAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  enrollments         Enrollment[]
  reviewedEnrollments Enrollment[]     @relation("EnrollmentReviewer")
  createdCourses      Course[]         @relation("CourseCreatedBy")
  generationJobs      GenerationJob[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]       @relation("AuditActor")
  teacherSessions     TeacherSession[] @relation("TeacherSessionLoggedBy")
  events              EventLog[]
  contentIssues       ContentIssue[]   @relation("ContentIssueReporter")

  @@index([role])
  @@index([cohortId])
}

model Cohort {
  id          String   @id @default(cuid())
  name        String   @unique
  condition   String // AI_ASSISTED | WITH_TEACHER | CONTROL | ... (расширяемо)
  description String?
  createdAt   DateTime @default(now())

  users           User[]
  teacherSessions TeacherSession[]
  events          EventLog[]
}

/// Refresh-токены с ротацией (FR-1.6): храним хеш, отзыв — по инвалидации.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  // Цепочка ротации: заменяющий токен
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ── Курсы, языковые версии, модули, лекции ────────────────────────────────

model Course {
  id              String        @id @default(cuid())
  defaultLanguage String // базовый язык (§4.3)
  status          PublishStatus @default(DRAFT)
  createdById     String
  createdBy       User          @relation("CourseCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  languageVersions CourseLanguageVersion[]
  enrollments      Enrollment[]
}

model CourseLanguageVersion {
  id          String        @id @default(cuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language    String // kk|ru|en
  title       String
  description String?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  modules        Module[]
  enrollments    Enrollment[]
  generationJobs GenerationJob[]
  finalMiniQuiz  Quiz? // итоговый мини-квиз по курсу (тренировочный)

  @@unique([courseId, language]) // §10.1
  @@index([status])
}

model Module {
  id                      String                @id @default(cuid())
  courseLanguageVersionId String
  languageVersion         CourseLanguageVersion @relation(fields: [courseLanguageVersionId], references: [id], onDelete: Cascade)
  orderIndex              Int
  title                   String
  assessmentType          AssessmentType        @default(QUIZ)
  // Практическое задание может охватывать весь курс (FR-2.3)
  coversWholeCourse       Boolean               @default(false)

  lectures      Lecture[]
  quiz          Quiz?
  practicalTask PracticalTask?

  @@unique([courseLanguageVersionId, orderIndex])
}

model Lecture {
  id             String   @id @default(cuid())
  moduleId       String
  module         Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  orderIndex     Int
  title          String
  youtubeVideoId String // валидированный ID (FR-4.3)
  transcriptText String   @db.Text // расшифровка (FR-2.4), источник для ИИ-генерации
  durationSec    Int? // длительность видео, сек (для оценки оставшегося времени)
  summary        String?  @db.Text // краткое содержание лекции (≤ LECTURE_SUMMARY_MAX_CHARS)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  progress LectureProgress[]
  miniQuiz Quiz? // мини-квиз после лекции (тренировочный)

  @@unique([moduleId, orderIndex])
}

// ── Тесты ─────────────────────────────────────────────────────────────────

// Тест. Три вида (kind), см. QuizKind:
//  - MODULE_FINAL  — итоговый тест модуля (оценивается, §4.5);
//  - LECTURE_MINI  — мини-квиз после лекции (тренировочный, не оценивается);
//  - COURSE_FINAL  — итоговый мини-квиз по курсу (тренировочный).
// Тренировочные (isGraded=false) не создают попыток, не влияют на прогресс и не
// попадают в оценочную телеметрию — так сохраняется валидность исследования.
// Вопросы/редактор/генерация переиспользуются (расширяемость §9.3).
model Quiz {
  id       String   @id @default(cuid())
  kind     QuizKind @default(MODULE_FINAL)
  isGraded Boolean  @default(true)

  // Ровно одна из привязок заполнена — в зависимости от kind
  moduleId                String?                @unique
  module                  Module?                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lectureId               String?                @unique
  lecture                 Lecture?               @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  courseLanguageVersionId String?                @unique
  languageVersion         CourseLanguageVersion? @relation(fields: [courseLanguageVersionId], references: [id], onDelete: Cascade)

  title           String
  passThreshold   Float            @default(0.7) // FR-5.4
  maxAttempts     Int              @default(2) // FR-5.6
  reviewPolicy    QuizReviewPolicy @default(FULL_AFTER_FINAL) // что видно после попытки (USER_DECISIONS §1)
  scoringRule     QuizScoringRule  @default(BEST) // какая попытка идёт в зачёт (USER_DECISIONS §1)
  // Пауза между попытками, мин: null → env QUIZ_COOLDOWN_MINUTES (по умолчанию
  // 1440 = 24 ч, USER_DECISIONS §1); 0 — без паузы
  cooldownMinutes Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id               String       @id @default(cuid())
  quizId           String
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type             QuestionType
  prompt           String       @db.Text
  options          Json // string[]
  correctOptionIds Json // number[] — индексы правильных вариантов
  explanation      String?      @db.Text
  difficulty       Difficulty   @default(MEDIUM)
  orderIndex       Int
  isAIGenerated    Boolean      @default(false) // FR-5.2, FR-7.4
  isEdited         Boolean      @default(false) // ручная правка (FR-7.4)
  optionRationales Json? // string[] параллельно options (индекс = id варианта): почему вариант верен/неверен
  sourceLectureId  String? // лекция-источник вопроса (ссылка «пересмотреть» в разборе)
  sourceTimecode   String? // 'mm:ss' — место в лекции-источнике
  // Общий ключ ru-вопроса и его kk/en переводов, напр. polit:M2:Q5 —
  // для межъязыкового анализа заданий
  canonicalKey     String?
  // Архивированные вопросы остаются для разбора старых попыток; списки студента
  // и редактора фильтруют archivedAt: null
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())

  @@unique([quizId, orderIndex]) // защита от дублей при ретрае/перегенерации (аудит H1)
  @@index([quizId])
  @@index([canonicalKey])
}

// ── Практическое задание ──────────────────────────────────────────────────

model PracticalTask {
  id                     String     @id @default(cuid())
  moduleId               String     @unique // 1:1 с модулем типа PRACTICAL
  module                 Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                  String
  scenarioPrompt         String     @db.Text // виден студенту (§5.3)
  referenceSolution      String     @db.Text // СКРЫТО от студента
  rubricSpec             Json // { key_points[], answer_reached_criteria } — СКРЫТО
  difficulty             Difficulty @default(MEDIUM)
  tokenBudget            Int        @default(9000) // предохранитель (§5.6)
  maxAiMessages          Int        @default(22) // основной лимит (FR-6.4)
  // Окно доступности (NFR-1.8): растянутое окно вместо жёсткого дедлайна —
  // сглаживание пиков сдачи (основной сценарий деградации чата в день дедлайна).
  availableFrom          DateTime?
  availableUntil         DateTime?
  systemPromptTemplateId String? // §10.1
  isAIGenerated          Boolean    @default(false)
  isEdited               Boolean    @default(false)
  maxSessions            Int        @default(2) // число зачётных попыток-сессий (USER_DECISIONS §4)
  agenda                 Json? // string[] (≤ 3) — план беседы, виден студенту
  estimatedMinutes       Int? // ориентировочная длительность, мин
  introMessage           String?    @db.Text // первая реплика тьютора
  // Канонический межъязыковой сценарий, напр. polisia-v1 (USER_DECISIONS §4):
  // перегенерация такого задания заблокирована
  canonicalRef           String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  sessions PracticalSession[]
}

// ── Запись на курс и прогресс ─────────────────────────────────────────────

model Enrollment {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  languageVersionId String // выбранный язык прохождения (§4.3)
  languageVersion   CourseLanguageVersion @relation(fields: [languageVersionId], references: [id])
  // ACTIVE по умолчанию — прямая запись менеджером (FR-8.1); заявка из каталога — PENDING.
  status            EnrollmentStatus      @default(ACTIVE)
  progressPercent   Float                 @default(0)
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  // Заявка студента и решение по ней (одобрение/отклонение менеджером или админом)
  requestedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?                 @relation("EnrollmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote        String?
  // Точка возобновления («Продолжить»). Блокировка языка НЕ хранится —
  // вычисляется по оцениваемой активности (USER_DECISIONS §3).
  lastLectureId     String? // последняя открытая лекция
  lastActivityAt    DateTime? // время последней учебной активности

  lectureProgress   LectureProgress[]
  quizAttempts      QuizAttempt[]
  practicalSessions PracticalSession[]
  certificate       Certificate?

  @@unique([userId, courseId]) // один enrollment на курс
  @@index([userId])
  @@index([status])
}

model LectureProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lectureId    String
  lecture      Lecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?
  // Позиция возобновления видео
  positionSec  Int        @default(0) // последняя позиция воспроизведения, сек
  watchedSec   Int        @default(0) // суммарно просмотрено, сек
  lastViewedAt DateTime? // когда лекцию открывали последний раз

  @@unique([enrollmentId, lectureId])
}

/// Попытка оцениваемого теста. submittedAt = NULL — попытка в процессе: она
/// занимает слот попытки, и ВСЕ агрегаты score/passed обязаны фильтровать
/// submittedAt != null.
model QuizAttempt {
  id                String     @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  quizId            String
  quiz              Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers           Json       @default("{}") // { questionId: number[] } — канонические id вариантов
  score             Float      @default(0)
  passed            Boolean    @default(false)
  startedAt         DateTime   @default(now())
  submittedAt       DateTime?
  flagged           Json? // string[] — id вопросов, отмеченных «вернуться позже»
  integrityAck      Boolean    @default(false) // студент подтвердил правила честной сдачи
  unansweredCount   Int        @default(0) // сколько вопросов осталось без ответа при отправке
  lastSavedAt       DateTime? // последнее автосохранение ответов
  // AttemptPresentation: порядок показа вопросов и вариантов в этой попытке;
  // ответы хранятся по каноническим id вариантов (USER_DECISIONS §1)
  presentation      Json?
  autoSubmitted     Boolean    @default(false) // отправлена системой по истечении срока (A15)
  activeDurationSec Int? // активное время в попытке, сек
  legacy            Boolean    @default(false) // записана устаревшим одношаговым эндпоинтом

  @@index([enrollmentId])
  @@index([quizId])
  @@index([enrollmentId, quizId])
}

// ── Сократические сессии ──────────────────────────────────────────────────

model PracticalSession {
  id                String            @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  practicalTaskId   String
  practicalTask     PracticalTask     @relation(fields: [practicalTaskId], references: [id])
  status            SessionStatus     @default(IN_PROGRESS)
  tokensUsed        Int               @default(0) // серверный учёт (§5.6)
  aiMessageCount    Int               @default(0) // основной лимит (FR-6.4)
  maxAiMessages     Int               @default(22) // снимок лимита на момент старта сессии
  verdictReason     String?           @db.Text
  evaluationResult  Json? // агрегат рубрики (§5.5)
  integrityFlags    Json? // сигналы целостности (FR-6.11)
  orchestrationMode OrchestrationMode @default(TUTOR_JUDGE)
  modelUsed         String? // воспроизводимость (FR-R.7)
  promptTemplateId  String? // воспроизводимость (FR-R.7)
  startedAt         DateTime          @default(now())
  lastActivityAt    DateTime          @default(now()) // для idle-паузы (§5.7)
  endedAt           DateTime?
  verdictCode       String? // PASSED | FAILED_LIMIT | FAILED_CEILING | ENDED_BY_STUDENT | ABANDONED
  endReason         String? // DONE | OTHER | LIMIT | CEILING | PASSED | IDLE | IDLE_AFTER_PAUSE
  summary           Json? // SessionEvaluation — итоговая оценка для студента
  summaryStatus     String? // PENDING | READY | FAILED
  metrics           Json? // PracticalSessionMetrics (воспроизводимость, FR-R.7)
  taskSnapshot      Json? // PracticalTaskSnapshot — снимок задания на момент старта
  excusedAt         DateTime? // сессия засчитана как уважительная: не считается попыткой (A7)
  excusedById       String? // кто из сотрудников освободил сессию

  messages ChatMessage[]

  @@index([enrollmentId])
  @@index([status])
}

model ChatMessage {
  id                String           @id @default(cuid())
  sessionId         String
  session           PracticalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role              ChatRole
  content           String           @db.Text
  tokensIn          Int              @default(0)
  tokensOut         Int              @default(0)
  cachedInputTokens Int              @default(0) // из tokensIn — кешированные входные токены (учёт стоимости)
  reasoningTokens   Int              @default(0) // из tokensOut — токены рассуждения модели
  leakCheck         Json? // результат проверки реплики тьютора на утечку ответа (A21)
  // Пошаговая оценка рубрики для реплики студента (§5.5, FR-R.3)
  turnAssessment    Json?
  // Сигналы целостности конкретной реплики (FR-6.11)
  integrityFlags    Json?
  createdAt         DateTime         @default(now())

  @@index([sessionId])
}

// ── Сертификаты ───────────────────────────────────────────────────────────

model Certificate {
  id           String     @id @default(cuid())
  enrollmentId String     @unique // 1:1
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  serialNumber String     @unique // уникальный серийный номер (FR-9.2)
  issuedAt     DateTime   @default(now())
  fileRef      String? // путь/ключ PDF
  hash         String? // контроль целостности
}

// ── ИИ-операции: задачи генерации и промпт-шаблоны ────────────────────────

model GenerationJob {
  id                      String                @id @default(cuid())
  courseLanguageVersionId String
  languageVersion         CourseLanguageVersion @relation(fields: [courseLanguageVersionId], references: [id], onDelete: Cascade)
  type                    GenerationType
  params                  Json
  status                  JobStatus             @default(QUEUED)
  result                  Json?
  error                   String?               @db.Text
  createdById             String
  createdBy               User                  @relation(fields: [createdById], references: [id])
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([courseLanguageVersionId])
  @@index([status])
}

/// Версия промпт-шаблона (FR-R.7 — воспроизводимость ИИ-операций).
model PromptTemplate {
  id        String     @id @default(cuid())
  kind      PromptKind
  language  String
  version   String
  content   String     @db.Text
  createdAt DateTime   @default(now())

  @@unique([kind, language, version])
}

// ── Исследование: телеметрия, занятия с преподавателем, аудит ─────────────

/// Единый журнал событий (FR-R.2, Приложение E).
model EventLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollmentId String?
  sessionId    String?
  cohortId     String?
  cohort       Cohort?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  eventType    String
  payload      Json
  createdAt    DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([cohortId])
  @@index([createdAt])
}

/// Ручная регистрация занятия с преподавателем (FR-R.9).
model TeacherSession {
  id         String   @id @default(cuid())
  cohortId   String
  cohort     Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  date       DateTime
  topic      String
  loggedById String
  loggedBy   User     @relation("TeacherSessionLoggedBy", fields: [loggedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([cohortId])
}

/// Аудит действий администратора и менеджера (NFR-2.9).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String // напр. USER_CREATED, ROLE_CHANGED, DATA_EXPORTED, COURSE_PUBLISHED
  targetType String?
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

// ── Качество контента: жалобы и системные отметки ─────────────────────────

/// Жалоба студента на контент или системная отметка на проверку (эксперт,
/// носитель языка, факт-чек). Сотрудник разбирает её в очереди жалоб.
model ContentIssue {
  id                String             @id @default(cuid())
  origin            ContentIssueOrigin @default(STUDENT) // жалоба студента или отметка контент-скрипта
  reporterId        String? // автор жалобы (null — системная отметка или удалённый пользователь)
  reporter          User?              @relation("ContentIssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  enrollmentId      String? // запись на курс, из которой подана жалоба
  targetType        ContentIssueTarget // тип объекта жалобы
  targetId          String // id объекта (вопрос, сообщение, лекция, задание)
  reason            String // код причины из CONTENT_ISSUE_REASONS / SYSTEM_REVIEW_REASONS
  comment           String?            @db.Text // свободный комментарий автора
  context           String // PRACTICE | REVIEW | OFFICIAL | PRACTICAL | LECTURE | CONTENT_PIPELINE
  courseId          String? // курс — для фильтрации очереди
  languageVersionId String? // языковая версия — для фильтрации очереди
  status            ContentIssueStatus @default(OPEN) // состояние разбора
  resolvedById      String? // кто из сотрудников закрыл жалобу
  resolvedAt        DateTime? // когда закрыта
  note              String?            @db.Text // заметка сотрудника при закрытии
  dedupeKey         String?            @unique // ключ идемпотентности системных отметок
  createdAt         DateTime           @default(now())

  @@index([status, courseId])
  @@index([targetType, targetId])
  @@index([origin, status])
}

/// Журнал применённых контент-скриптов — делает их идемпотентными.
model ContentMigration {
  id        String   @id @default(cuid())
  key       String   @unique // уникальный ключ скрипта/шага, напр. polit-bank-v2
  appliedAt DateTime @default(now()) // когда применён
  detail    Json? // сводка: что и сколько изменено
}
